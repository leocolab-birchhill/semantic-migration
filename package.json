{
  "name": "view-reconciliation-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Skill-first Looker → Databricks metric-view migration CLI (filesystem artifacts, no job DB)",
  "scripts": {
    "auth:databricks": "node --use-system-ca --import tsx scripts/ensure-databricks-auth.ts",
    "cli:doctor": "node --use-system-ca --import tsx scripts/cli/doctor.ts",
    "cli:inventory": "node --use-system-ca --import tsx scripts/cli/inventory.ts",
    "cli:plan": "node --use-system-ca --import tsx scripts/cli/plan.ts",
    "cli:discover": "node --use-system-ca --import tsx scripts/cli/discover.ts",
    "cli:draft": "node --use-system-ca --import tsx scripts/cli/draft.ts",
    "cli:deploy": "node --use-system-ca --import tsx scripts/cli/deploy.ts",
    "cli:parity": "node --use-system-ca --import tsx scripts/cli/parity.ts",
    "cli:publish": "node --use-system-ca --import tsx scripts/cli/publish.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^7.3.0",
    "uuid": "^14.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
